# Loaded automatically by `npm run dev`.
#
# Testing from a real phone on the same wifi? "localhost" means the PHONE, not
# your laptop -- replace this with the laptop's LAN address, e.g.
#   VITE_API_BASE_URL=http://192.168.1.7:8000
# and start uvicorn with --host 0.0.0.0 so it accepts connections from the LAN.
VITE_API_BASE_URL=http://127.0.0.1:8000
